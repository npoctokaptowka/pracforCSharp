<Window x:Class="prac_11.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Цифровые часы" Height="250" Width="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ClockText"
                   FontSize="48"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Слева" Width="80" Margin="5" Click="LeftClick"/>
            <Button Content="Справа" Width="80" Margin="5" Click="RightClick"/>
            <Button Content="Сверху" Width="80" Margin="5" Click="TopClick"/>
            <Button Content="Снизу" Width="80" Margin="5" Click="BottomClick"/>
        </StackPanel>
    </Grid>
</Window>