<Window x:Class="prac12.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp26"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Управление цветов"
                       FontSize="25"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" Rows="2">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Rectangle x:Name="Rect1" Width="150" Height="80"
                           Fill="Black" Stroke="CadetBlue" StrokeThickness="5"
                           MouseDown="Shape_Click"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Rectangle x:Name="Square1" Width="80" Height="80"
                           Fill="Black" Stroke="CadetBlue" StrokeThickness="5"
                           MouseDown="Shape_Click"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="Ellipse1" Width="180" Height="80"
                         Fill="Black" Stroke="CadetBlue" StrokeThickness="5"
                         MouseDown="Shape_Click"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="Circle1" Width="80" Height="80"
                         Fill="Black" Stroke="CadetBlue" StrokeThickness="5"
                         MouseDown="Shape_Click"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="RoundRect1" Width="180" Height="80"
                        Background="Black" BorderBrush="DarkBlue"
                        CornerRadius="20" BorderThickness="5"
                        MouseDown="Shape_Click"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="RoundSquare1" Width="80" Height="80"
                        Background="Black" BorderBrush="DarkBlue"
                        CornerRadius="20" BorderThickness="5"
                        MouseDown="Shape_Click"/>
            </StackPanel>
        </UniformGrid>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Center">
            <Button Background="Black" Width="40" Height="40" Margin="4"
                    PreviewMouseLeftButtonDown="Color_Left" PreviewMouseRightButtonDown="Color_Right"/>
            <Button Background="Red" Width="40" Height="40" Margin="4"
                    PreviewMouseLeftButtonDown="Color_Left" PreviewMouseRightButtonDown="Color_Right"/>
            <Button Background="Gray" Width="40" Height="40" Margin="4"
                    PreviewMouseLeftButtonDown="Color_Left" PreviewMouseRightButtonDown="Color_Right"/>
            <Button Background="Green" Width="40" Height="40" Margin="4"
                    PreviewMouseLeftButtonDown="Color_Left" PreviewMouseRightButtonDown="Color_Right"/>
            <Button Background="Yellow" Width="40" Height="40" Margin="4"
                    PreviewMouseLeftButtonDown="Color_Left" PreviewMouseRightButtonDown="Color_Right"/>
            <Button Background="Wheat" Width="40" Height="40" Margin="4"
                    PreviewMouseLeftButtonDown="Color_Left" PreviewMouseRightButtonDown="Color_Right"/>
            <Button Background="White" Width="40" Height="40" Margin="4"
                    PreviewMouseLeftButtonDown="Color_Left" PreviewMouseRightButtonDown="Color_Right"/>
            <Button Background="Pink" Width="40" Height="40" Margin="4"
                    PreviewMouseLeftButtonDown="Color_Left" PreviewMouseRightButtonDown="Color_Right"/>
            <Button Background="Brown" Width="40" Height="40" Margin="4"
                    PreviewMouseLeftButtonDown="Color_Left" PreviewMouseRightButtonDown="Color_Right"/>
            <Button Background="Orange" Width="40" Height="40" Margin="4"
                    PreviewMouseLeftButtonDown="Color_Left" PreviewMouseRightButtonDown="Color_Right"/>
        </WrapPanel>
    </Grid>
</Window>