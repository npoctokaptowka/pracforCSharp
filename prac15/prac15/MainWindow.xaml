<Window x:Class="prac15.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Блокнот" Height="600" Width="900" MinHeight="400" MinWidth="600">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Создать" Click="NewFile_Click"/>
                <MenuItem Header="Открыть..." Click="OpenFile_Click"/>
                <Separator/>
                <MenuItem Header="Сохранить" Click="SaveFile_Click"/>
                <MenuItem Header="Сохранить как..." Click="SaveAsFile_Click"/>
                <Separator/>
                <MenuItem Header="Печать..." Click="PrintFile_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Правка">
                <MenuItem Header="Отменить" Click="Undo_Click"/>
                <MenuItem Header="Повторить" Click="Redo_Click"/>
                <Separator/>
                <MenuItem Header="Вырезать" Click="Cut_Click"/>
                <MenuItem Header="Копировать" Click="Copy_Click"/>
                <MenuItem Header="Вставить" Click="Paste_Click"/>
                <MenuItem Header="Удалить" Click="Delete_Click"/>
                <Separator/>
                <MenuItem Header="Найти" Click="ShowFindPanel_Click"/>
                <MenuItem Header="Заменить" Click="ShowReplacePanel_Click"/>
                <Separator/>
                <MenuItem Header="Выделить всё" Click="SelectAll_Click"/>
            </MenuItem>
            <MenuItem Header="Формат">
                <MenuItem Header="Перенос по словам" IsCheckable="True" IsChecked="True" Click="WordWrap_Click"/>
                <Separator/>
                <MenuItem Header="Увеличить шрифт" Click="IncreaseFont_Click"/>
                <MenuItem Header="Уменьшить шрифт" Click="DecreaseFont_Click"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О программе" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Ж" Width="32" FontWeight="Bold" ToolTip="Жирный" Click="Bold_Click"/>
                <Button Content="К" Width="32" FontStyle="Italic" ToolTip="Курсив" Click="Italic_Click"/>
                <Button Content="Ч" Width="32" ToolTip="Подчёркнутый" Click="Underline_Click"/>
                <Separator/>
                <ComboBox x:Name="FontFamilyComboBox" Width="180" ToolTip="Шрифт"
                          SelectionChanged="FontFamilyComboBox_SelectionChanged"/>
                <ComboBox x:Name="FontSizeComboBox" Width="70" ToolTip="Размер шрифта"
                          SelectionChanged="FontSizeComboBox_SelectionChanged"/>
                <Separator/>
                <ComboBox x:Name="FontColorComboBox" Width="120" ToolTip="Цвет текста"
                          SelectionChanged="FontColorComboBox_SelectionChanged">
                    <ComboBoxItem Content="Чёрный" Tag="Black"/>
                    <ComboBoxItem Content="Красный" Tag="Red"/>
                    <ComboBoxItem Content="Синий" Tag="Blue"/>
                    <ComboBoxItem Content="Зелёный" Tag="Green"/>
                    <ComboBoxItem Content="Серый" Tag="Gray"/>
                </ComboBox>
                <Separator/>
                <Button Content="⬅" Width="32" ToolTip="Выровнять по левому краю" Click="AlignLeft_Click"/>
                <Button Content="↔" Width="32" ToolTip="Выровнять по центру" Click="AlignCenter_Click"/>
                <Button Content="➡" Width="32" ToolTip="Выровнять по правому краю" Click="AlignRight_Click"/>
                <Button Content="☰" Width="32" ToolTip="Выровнять по ширине" Click="AlignJustify_Click"/>
            </ToolBar>

            <ToolBar Band="1">
                <TextBlock Text="Оформление:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="DocStyleComboBox" Width="200"
                          SelectionChanged="DocStyleComboBox_SelectionChanged">
                    <ComboBoxItem Content="Учебный конспект"/>
                    <ComboBoxItem Content="Официальная записка"/>
                    <ComboBoxItem Content="Черновик"/>
                    <ComboBoxItem Content="Код программы"/>
                    <ComboBoxItem Content="Презентационные заметки"/>
                </ComboBox>
                <CheckBox x:Name="WholeDocumentCheckBox" Content="Применить ко всему документу"
                          IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </ToolBar>
        </ToolBarTray>

        <Border x:Name="FindPanel" DockPanel.Dock="Top" Background="#EEEEEE" Padding="8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Найти:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="FindTextBox" Width="180" Margin="0,0,10,0"/>
                <Button Content="Найти далее" Width="90" Margin="0,0,10,0" Click="FindNext_Click"/>
                <TextBlock x:Name="ReplaceTextBlock" Text="Заменить:" VerticalAlignment="Center"
                           Margin="0,0,5,0" Visibility="Collapsed"/>
                <TextBox x:Name="ReplaceTextBox" Width="180" Margin="0,0,10,0" Visibility="Collapsed"/>
                <Button x:Name="ReplaceButton" Content="Заменить" Width="80" Margin="0,0,10,0"
                        Visibility="Collapsed" Click="Replace_Click"/>
                <Button x:Name="ReplaceAllButton" Content="Заменить всё" Width="100" Margin="0,0,10,0"
                        Visibility="Collapsed" Click="ReplaceAll_Click"/>
                <CheckBox x:Name="CaseSensitiveCheckBox" Content="Учитывать регистр"
                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="Закрыть" Width="70" Click="CloseFindPanel_Click"/>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="LineColumnText" Text="Строка: 1, Столбец: 1"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="CharCountText" Text="Символов: 0"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="DocStyleText" Text="Оформление: не выбрано"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="FilePathText" Text="Новый файл"/>
            </StatusBarItem>
        </StatusBar>

        <RichTextBox x:Name="Editor"
                     AcceptsTab="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="16"
                     Padding="8"
                     TextChanged="Editor_TextChanged"
                     SelectionChanged="Editor_SelectionChanged">
            <FlowDocument>
                <Paragraph/>
            </FlowDocument>
        </RichTextBox>
    </DockPanel>
</Window>
