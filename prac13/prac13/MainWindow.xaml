<Window x:Class="prac13.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Двойное подтверждение" Height="350" Width="500"
        KeyDown="Window_KeyDown" Closing="Window_Closing">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Сброс" InputGestureText="Ctrl+R" Click="Reset_Click"/>
                <Separator/>
                <MenuItem Header="Выход" InputGestureText="Ctrl+Q" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Цвет">
                <MenuItem Header="Красный" InputGestureText="Ctrl+1" Click="Red_Click"/>
                <MenuItem Header="Зелёный" InputGestureText="Ctrl+2" Click="Green_Click"/>
                <MenuItem Header="Синий" InputGestureText="Ctrl+3" Click="Blue_Click"/>
            </MenuItem>
        </Menu>

        <Border x:Name="Box" Width="220" Height="130"
                Background="LightGray" BorderBrush="Black" BorderThickness="3">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Красный" InputGestureText="Ctrl+1" Click="Red_Click"/>
                    <MenuItem Header="Зелёный" InputGestureText="Ctrl+2" Click="Green_Click"/>
                    <MenuItem Header="Синий" InputGestureText="Ctrl+3" Click="Blue_Click"/>
                    <Separator/>
                    <MenuItem Header="Сброс" InputGestureText="Ctrl+R" Click="Reset_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
        </Border>
    </DockPanel>
</Window>