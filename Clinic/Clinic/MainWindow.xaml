<Window x:Class="Clinic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поликлиника" Height="550" Width="950" MinHeight="400" MinWidth="650">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Background="#E8EEF4" MinWidth="170">
            <TextBlock Text="Поликлиника" FontSize="20" FontWeight="Bold" Margin="10,15,10,15"/>
            <Button Content="Пациенты" Height="35" Margin="10,5" Click="Patients_Click"/>
            <Button Content="Врачи" Height="35" Margin="10,5" Click="Doctors_Click"/>
            <Button Content="Кабинеты" Height="35" Margin="10,5" Click="Cabinets_Click"/>
            <Button Content="Приёмы" Height="35" Margin="10,5" Click="Appointments_Click"/>
            <Button Content="← Назад" Height="35" Margin="10,25,10,5" Click="Back_Click"/>
        </StackPanel>

        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
