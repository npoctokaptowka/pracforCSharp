<Page x:Class="Clinic.TablePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Таблица">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,5"/>
            <TextBox x:Name="SearchBox" Width="220" Margin="0,0,15,5" TextChanged="SearchBox_TextChanged"/>
            <Button Content="Добавить" Width="100" Margin="0,0,5,5" Click="Add_Click"/>
            <Button Content="Изменить" Width="100" Margin="0,0,5,5" Click="Edit_Click"/>
            <Button Content="Удалить" Width="100" Margin="0,0,5,5" Click="Delete_Click"/>
            <Button Content="Назад" Width="100" Margin="0,0,5,5" Click="Back_Click"/>
        </WrapPanel>

        <DataGrid x:Name="DataTableGrid" Grid.Row="2"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  ColumnWidth="*"
                  MouseDoubleClick="DataTableGrid_MouseDoubleClick"/>
    </Grid>
</Page>
