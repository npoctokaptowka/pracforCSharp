<Window x:Class="Clinic.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование" Width="520" MinWidth="400"
        SizeToContent="Height" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="15">
        <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <Grid x:Name="FieldsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Сохранить" Width="100" Margin="0,0,10,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="Отмена" Width="100" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
